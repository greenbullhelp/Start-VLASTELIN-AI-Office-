# ======== Джарвіс: налаштування сервера ========
# Скопіюйте у .env (це робить install.sh) і заповніть. Файл .env НІКОЛИ не потрапляє в GitHub.

# --- Обов'язково ---
# ключ з console.anthropic.com (Settings → API Keys)
ANTHROPIC_API_KEY=
# секрет між панеллю і Hermes; install.sh генерує сам
API_SERVER_KEY=
# напр. 203-0-113-7.sslip.io (install.sh підставляє за IP сервера)
PANEL_DOMAIN=
# https://<PANEL_DOMAIN>
PUBLIC_URL=
# Ваше ім'я — як до вас звертатиметься Джарвіс
OWNER_NAME=
TZ=Europe/Kyiv

# --- Моделі й гроші ---
MODEL_CHEAP=claude-haiku-5-5
MODEL_MEDIUM=claude-sonnet-5-5
MODEL_STRONG=claude-opus-5-5
DAILY_BUDGET_USD=3
MAX_PARALLEL_AGENTS=2
REPORT_HOUR=21
# hermes | anthropic (запасний: пряма розмова з Claude без інструментів)
BRAIN=hermes

# --- Telegram (необов'язково) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- ПК-вузол (необов'язково) ---
# install.sh генерує; той самий токен вводиться у вузлі на ПК
NODE_TOKEN=
# IP сервера в Tailscale (100.x.y.z), коли підключите вузол
TAILSCALE_IP=127.0.0.1

# --- Платний запасний API графіки (лише з вашого підтвердження) ---
STABILITY_API_KEY=

# --- Голос ---
# local (Whisper на сервері) | node | none
STT_PROVIDER=local
STT_MODEL=base
WITH_WHISPER=1

# --- Агенти й GitHub (необов'язково) ---
# fine-grained токен ЛИШЕ на репозиторій гри (Contents: write)
AGENT_GH_TOKEN=
# напр. greenbullhelp/vlastelin-cards
GAME_REPO=

COOKIE_SECURE=1
